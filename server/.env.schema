# @defaultSensitive=false @defaultRequired=true
# @generateTypes(lang=ts, path=src/env.d.ts, auto=false)
# @currentEnv=$NODE_ENV

# Application runtime environment (development/production etc.)
# @type=string
NODE_ENV=development

# Where the API mounts under (e.g. "/" or "/api")
# @type=string
BASE_URL=/

# HTTP port the server listens on
# @type=number
PORT=3000

# Postgres connection string. In dev mode, defaults to a local Postgres on :5432.
# Override in .env for any other environment.
# @type=string @sensitive
DATABASE_URL=if(forEnv(development), "postgres://postgres:postgres@localhost:5432/battlelog")

# When true, mount /rmapi/* routes for RM (Rasenmaeher) integration. On by
# default: the RM deployment injects no app env beyond the DB config, so a
# false default would leave the product silently unreachable to RM.
# @type=boolean
RM_API_ENABLED=true

# When true, /rmapi/* endpoints reject callers without an expected mTLS DN header.
# Off in dev — no proxy locally to inject the header.
# @type=boolean
RM_MTLS_ENFORCE=if(forEnv(development), false, true)

# Header name that carries the client's mTLS DN.
# @type=string
RM_MTLS_HEADER=x-clientcert-dn

# Expected CN for RM callers. If unset, falls back to kraftwerk-init.json then "rasenmaeher".
# @required=false @type=string
RM_EXPECTED_CERT_CN=

# When true, /api/* writes require mTLS-derived user identity (cert CN from
# RM_MTLS_HEADER becomes createdBy/updatedBy). Off in dev — no proxy locally.
# @type=boolean
RM_MTLS_USER_ENFORCE=if(forEnv(development), false, true)

# When true, expose /openapi.json + /api-docs swagger UI. Enabled by default in dev.
# @type=boolean
USE_SWAGGER=if(forEnv(development), true, false)

# OTLP endpoint for OpenTelemetry traces/metrics. When unset, the SDK is not started.
# @required=false @type=string
OTEL_EXPORTER_OTLP_ENDPOINT=

# Pino log level.
# @type=enum(trace,debug,info,warn,error,fatal)
LOG_LEVEL=info

# CA certificates used to verify deployment peers (TAK, RASENMAEHER, sibling
# products). A directory loads every certificate in it, which is what a
# deployment needs: RM's CA signs client certs, miniwerk's signs server certs.
# @type=string
CA_PATH=/ca_public

# --- TAK CoT ingest ---------------------------------------------------------
# Opens a mTLS CoT stream to TAK Server and turns matching CoT into events.
# Which CoT is ingested is chosen at runtime through /api/v1/ingest/sources, not
# here — these settings only say where TAK is and how to authenticate to it.

# Host of TAK Server's CoT streaming input. Setting this is what enables the
# ingester, so a deployment that passes no TAK env stays entirely off.
# @required=false @type=string
TAK_STREAM_HOST=

# Port of the TLS CoT input (the RM composition's takserver uses 8089).
# @type=number
TAK_STREAM_PORT=8089

# SNI name to present, when it differs from TAK_STREAM_HOST. TAK's server cert is
# issued for its public FQDN, but inside docker we connect to a service name.
# @required=false @type=string
TAK_TLS_SERVERNAME=

# Log the raw XML of CoT this app could not parse. Off by default: the payload
# carries positions and chat bodies, and container logs travel further than the
# database does. Turn on only while debugging a producer.
# @type=boolean
TAK_LOG_RAW_COT=false

# Our RM-issued client certificate, written by kw_product_init on first run.
# @type=string
TAK_CLIENT_CERT_PATH=/data/persistent/public/mtlsclient.pem
# @type=string
TAK_CLIENT_KEY_PATH=/data/persistent/private/mtlsclient.key

# --- Matrix ingest ----------------------------------------------------------
# Reads messages from Matrix rooms and turns them into events. The access token
# comes from matrixrmapi over the product interop API, using the same client
# certificate as above. Which rooms are ingested is chosen at runtime through
# /api/v1/ingest/sources.

# Internal URL of the Synapse homeserver. Setting this is what enables the
# ingester, so a deployment that passes no Matrix env stays entirely off.
# @required=false @type=string
MATRIX_HOMESERVER_URL=

# Product name to ask RASENMAEHER for interop with, and the host to fetch the
# token from. Defaults match the RM composition's Matrix product.
# @type=string
MATRIX_PRODUCT_NAME=matrix

# Where the end-to-end encryption store lives. Same volume, same reason — it
# holds the device's identity and every megolm session shared with it.
# @type=string
MATRIX_CRYPTO_STORE=/data/persistent/matrix-crypto
