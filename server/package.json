{
  "name": "server",
  "version": "2.0.0",
  "description": "BattleLog backend (Hono + Drizzle + TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:fake": "tsx scripts/fake-events.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^0.18.4",
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "drizzle-orm": "^0.36.4",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.13.3",
    "hono-pino": "^0.7.2",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-opentelemetry-transport": "^1.1.0",
    "uuid": "^12.0.1",
    "varlock": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
