# Copy to web/.env.local for local dev. Deployed builds derive this from
# BattleLog's own hostname (battlelog.<deployment>) and leave it unset.

# PVARKI deployment the chat widget talks to (Matrix at https://synapse.<deployment>).
VITE_PVARKI_DEPLOYMENT=

# Dev-only TAK proxy: the Map page talks to TAK through /tak with this test
# certificate (deployed builds use the user's own certificate instead).
TAK_PROXY_TARGET=
TAK_CERT_PATH=
TAK_KEY_PATH=
TAK_CA_PATH=

# MML open map API key (free, from MML OmaTili). Without it the MML maps fall
# back to Kapsi's WMS, which Kapsi has started retiring.
VITE_MML_API_KEY=
