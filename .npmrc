# Refuse to install package versions newer than N minutes old.
# Hardens against fresh-publish supply-chain attacks (compromised maintainer accounts,
# typosquats that get caught within days). 14 days = 14 * 24 * 60 = 20160 minutes.
minimum-release-age=20160

# Packages allowed to install fresher than the limit above (comma-separated).
# Use sparingly — only for first-party or security-critical updates.
# minimum-release-age-exclude=
